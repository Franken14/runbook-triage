# Application Environment
APP_ENV=development
LOG_LEVEL=info

# Database (PostgreSQL 16 + pgvector)
DATABASE_URL=postgresql://incident_admin:secret_runbook_pass@localhost:5432/incident_db

# Redis 7
REDIS_URL=redis://localhost:6379/0

# Agent Guardrails & Thresholds
DEDUPLICATION_WINDOW_SECONDS=60
REQUIRE_APPROVAL_MUTATING_ACTIONS=true
MAX_DIAGNOSTIC_ITERATIONS=5

# LLM &Machine Learning Settings
OPENAI_API_KEY=your-openai-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
